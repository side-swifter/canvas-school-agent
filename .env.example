# Canvas instance URL, e.g. https://school.instructure.com; never commit secrets
CANVAS_BASE_URL=
CANVAS_TOKEN=
# Path containing an exported JSON list of additional browser-discovered documents
BROWSER_EXPORT_JSON=
# OpenAI-compatible /chat/completions endpoint (optional until configured)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Use dry run until you review detected events
DRY_RUN=true
# Todoist REST API integration
TODOIST_API_TOKEN=
TODOIST_PROJECT_ID=
# Google Calendar via OAuth access token managed by an external credential refresher
GOOGLE_ACCESS_TOKEN=
GOOGLE_CALENDAR_ID=
# Local database and date behavior
DB_PATH=state/agent.sqlite
TIMEZONE=America/New_York
LOOKAHEAD_DAYS=90
MAX_DOCUMENT_MB=15
