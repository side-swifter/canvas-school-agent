# Copy to ~/.config/school-agent/env (mode 600, OUTSIDE the repo). Never commit real values.
# --- Canvas (API first; browser is a fallback)
CANVAS_BASE_URL=
CANVAS_TOKEN=
# Playwright storage_state JSON from a session YOU logged into (outside git). Optional fallback.
CANVAS_BROWSER_STATE=
BROWSER_EXPORT_JSON=
# --- AI extraction (provider is configurable; nothing is sent until approved)
AI_PROVIDER=openai            # openai (any OpenAI-compatible endpoint) | anthropic
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Must be explicitly true before school text is sent to a non-local provider. localhost endpoints need no approval.
AI_DATA_APPROVED=false
# --- Safety: stays true until you have reviewed dry-run output AND run `school-agent approve-live`
DRY_RUN=true
# --- Todoist: use a SEPARATE test project first
TODOIST_API_TOKEN=
TODOIST_PROJECT_ID=
TODOIST_DEDUPE_ALL_PROJECTS=true
# --- Google Calendar: dedicated school calendar. OAuth client + refresh token live in ~/.config/school-agent/google.json
# (created by `school-agent auth-google`).  Read-only calendars (e.g. Canvas feed) are checked for collisions only.
GOOGLE_CALENDAR_ID=
GOOGLE_READONLY_CALENDAR_IDS=
# --- Alerts: always written to state/alerts.jsonl; optional webhook (ntfy.sh topic URL or similar)
ALERT_WEBHOOK_URL=
# --- Behaviour
DB_PATH=state/agent.sqlite
STATE_DIR=state
TIMEZONE=America/New_York
LOOKAHEAD_DAYS=90
MIN_CONFIDENCE=0.85
MAX_DOCUMENT_MB=15
